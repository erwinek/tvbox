[Unit]
Description=TVBox Boxer GUI (Sway kiosk FHD + transform)
After=multi-user.target systemd-user-sessions.service seatd.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=boxer
Group=boxer
WorkingDirectory=/home/boxer/tvbox
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStartPre=/bin/mkdir -p /run/user/1000
ExecStartPre=/bin/chown boxer:boxer /run/user/1000
ExecStartPre=/bin/chmod 700 /run/user/1000

ExecStart=/usr/bin/sway --config /home/boxer/tvbox/config/sway-kiosk.conf

Restart=on-failure
RestartSec=3
SupplementaryGroups=video render input dialout

[Install]
WantedBy=multi-user.target

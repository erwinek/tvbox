[Unit]
Description=TVBox Boxer GUI (Wyse user session)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/boxer/tvbox
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=SDL_VIDEODRIVER=wayland
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=PATH=/home/boxer/tvbox-env/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/home/boxer/tvbox-env/lib
ExecStart=/home/boxer/tvbox/bin/tvbox_gui /home/boxer/tvbox/config/app-wyse.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
